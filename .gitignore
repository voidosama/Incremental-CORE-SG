# Data is ~11.5 GB and every byte of it is reproducible: the public sets are
# fetched by scripts/fetch_data.sh, the synthetic ones are generated by
# scripts/run_suite.py --generate. Never commit it.
/data/

# Build trees
/build/
/out/
*.obj
*.o
*.lib
*.a
*.exe
*.pdb
*.ilk

# Results. Keep these out of the repo so the cluster and the laptop do not
# fight over them; copy results.csv back by hand.
*.csv
*.coresg
run.log
*.log
!scripts/*.csv

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
env/

# Assistant working notes that ended up in the project root. Not project
# artifacts, and not something to publish alongside the code.
/MEMORY.md
/coresg-thesis-project.md
/coresg-spec-deviations.md

# Editors / OS
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# LaTeX build output
artigo/build_tex/
*.aux
*.bbl
*.blg
*.synctex.gz
